{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/mobile.ts": { "maxDuration": 180 }
  },
  "rewrites": [
    {
      "source": "/api/download",
      "destination": "/api/mobile?resource=download"
    },
    {
      "destination": "/index.html",
      "source": "/(.*)"
    }
  ]
}
