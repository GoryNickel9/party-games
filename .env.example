# Set these in Vercel project settings and in a local .env.local file.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SESSION_SECRET=replace-with-a-long-random-value

# Android APK downloads/updates. Token is required for a private repository.
# Recommended: fine-grained token with Contents: read on this repository only.
# Existing GitHub CLI OAuth credentials are also supported. Server-only; never use VITE_.
ANDROID_RELEASE_REPOSITORY=GoryNickel9/PartyScore-Android
ANDROID_RELEASE_GITHUB_TOKEN=
